# Data Mining Practice .gitignore

# --------------------
# Python
# --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.egg-info/
dist/
build/
*.egg

# --------------------
# 环境配置
# --------------------
.venv/
venv/
ENV/

# --------------------
# IDE
# --------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --------------------
# Trae IDE
# --------------------
.trae/

# --------------------
# 输出文件 (保留提交结果)
# --------------------
# 忽略所有 CSV，但保留提交文件
*.csv
!submission*.csv
!submit_example.csv

# 模型文件
*.pkl
*.pt
*.pth
*.onnx
*.t7

# --------------------
# 日志和临时文件
# --------------------
*.log
*.logs
*.out
*.err
*.tmp
*.temp
*.bak

# --------------------
# 系统文件
# --------------------
.DS_Store
Thumbs.db

# --------------------
# Jupyter Notebooks
# --------------------
.ipynb_checkpoints/
*.ipynb

# --------------------
# 白名单
# --------------------
!README.md
!LICENSE
!*.md
